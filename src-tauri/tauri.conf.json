{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plugcam",
  "version": "0.2.0",
  "identifier": "io.github.plugcam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Plugcam",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu",
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Maxim Esipov",
    "copyright": "© 2026 Maxim Esipov. Apache-2.0.",
    "homepage": "https://github.com/Qwinty/plugcam",
    "category": "Video",
    "shortDescription": "Your Android phone as a webcam",
    "longDescription": "Plugcam turns an Android phone's camera into a Windows webcam over USB: no app on the phone, no watermarks, free and open source.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "resources/",
      "resources/x86/*": "resources/x86/",
      "resources/licenses/*": "licenses/",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "German",
          "Spanish",
          "French",
          "Italian",
          "Polish",
          "PortugueseBR",
          "Turkish",
          "Ukrainian",
          "Russian",
          "Japanese",
          "Korean",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRkZCNjc1QzhERjY3RkQKUldUOVo5L0lkYmIvc0lsendDRHZWczF4Q1IwZUZuamhhQ1gvaVVzMkpYUTR4M0wybGd6YVgwOGMK",
      "endpoints": [
        "https://github.com/Qwinty/plugcam/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
